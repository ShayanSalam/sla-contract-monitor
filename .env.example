# Copy this file to .env and fill in your real values. Never commit .env itself.

# Your local PostgreSQL connection (see README for setup steps)
DATABASE_URL=postgresql+psycopg://sla_user:your_password@localhost:5432/sla_monitor

# Used to sign JWT auth tokens - generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-generated-secret

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Get this from Google AI Studio -> API Keys
# Used by the Week 2 AI extraction feature (app/services/extraction.py)
GOOGLE_API_KEY=your-google-api-key-here
